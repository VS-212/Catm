{
  "schema_bundle_version": "3.0",
  "schemas": {
    "global_case": {
      "type": "object",
      "required": ["case_id", "retailer", "country", "archetype", "solution_pattern", "observed_solution", "stage", "source_ids", "customer_confirmed", "outcome_status", "negative_or_constraint", "confidence"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^V3-GC-[0-9]{5,}$"},
        "retailer": {"type": "string"},
        "country": {"type": "string"},
        "archetype": {"type": "string"},
        "solution_pattern": {"type": "string"},
        "observed_solution": {"type": "string"},
        "sponsor": {"type": ["string", "null"]},
        "vendor_or_inhouse": {"enum": ["vendor", "inhouse", "hybrid", "unknown"]},
        "stage": {"enum": ["interest", "pilot", "production", "scale", "stopped", "replaced", "unknown"]},
        "architecture_summary": {"type": ["string", "null"]},
        "data_requirements": {"type": "array", "items": {"type": "string"}},
        "outcome_raw": {"type": ["string", "null"]},
        "source_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "customer_confirmed": {"type": "boolean"},
        "outcome_status": {"enum": ["verified", "reported", "mixed", "negative", "not_disclosed"]},
        "negative_or_constraint": {"type": "array", "items": {"type": "string"}},
        "russia_transfer_notes": {"type": "array", "items": {"type": "string"}},
        "confidence": {"enum": ["high", "medium", "low"]}
      },
      "additionalProperties": false
    },
    "vendor_product": {
      "type": "object",
      "required": ["product_id", "vendor", "product", "capabilities", "confirmed_customer_cases", "deployment", "integration", "russia_availability", "evidence_ids", "confidence"],
      "properties": {
        "product_id": {"type": "string", "pattern": "^V3-VP-[0-9]{4,}$"},
        "vendor": {"type": "string"},
        "product": {"type": "string"},
        "capabilities": {"type": "array", "items": {"type": "string"}},
        "confirmed_customer_cases": {"type": "array", "items": {"type": "string"}},
        "vendor_only_cases": {"type": "array", "items": {"type": "string"}},
        "deployment": {"type": "string"},
        "integration": {"type": "array", "items": {"type": "string"}},
        "data_requirements": {"type": "array", "items": {"type": "string"}},
        "hitl_explainability": {"type": ["string", "null"]},
        "pricing_tco_raw": {"type": ["string", "null"]},
        "russia_availability": {"enum": ["available", "restricted", "unavailable", "unknown"]},
        "sanctions_lockin_risk": {"enum": ["low", "medium", "high", "unknown"]},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "confidence": {"enum": ["high", "medium", "low"]}
      },
      "additionalProperties": false
    },
    "github_repository": {
      "type": "object",
      "required": ["repo_id", "url", "owner_repo", "capability", "license", "latest_commit_date", "latest_release", "maintenance_status", "tests_ci", "security_review", "production_fit", "evidence_date"],
      "properties": {
        "repo_id": {"type": "string", "pattern": "^V3-GH-[0-9]{4,}$"},
        "url": {"type": "string", "format": "uri"},
        "owner_repo": {"type": "string"},
        "capability": {"type": "string"},
        "license": {"type": ["string", "null"]},
        "commercial_implications": {"type": "string"},
        "latest_commit_date": {"type": ["string", "null"], "format": "date"},
        "latest_release": {"type": ["string", "null"]},
        "maintenance_status": {"enum": ["active", "slow", "maintenance", "abandoned", "unknown"]},
        "contributors_raw": {"type": ["integer", "null"]},
        "tests_ci": {"enum": ["strong", "present", "weak", "absent", "unknown"]},
        "security_review": {"type": "string"},
        "docs_examples": {"type": "string"},
        "scale_evidence": {"type": ["string", "null"]},
        "production_fit": {"enum": ["component_ready", "prototype_only", "research_only", "not_fit", "unknown"]},
        "integration_effort": {"enum": ["low", "medium", "high", "unknown"]},
        "evidence_date": {"type": "string", "format": "date"}
      },
      "additionalProperties": false
    },
    "reference_architecture": {
      "type": "object",
      "required": ["architecture_id", "finalist_id", "business_capabilities", "data_inputs", "canonical_entities", "deterministic_components", "ml_components", "llm_components", "integrations", "hitl", "observability", "security_governance", "failure_fallbacks", "build_buy_partner_options", "pilot_blueprint"],
      "properties": {
        "architecture_id": {"type": "string", "pattern": "^V3-ARCH-[0-9]{2,}$"},
        "finalist_id": {"type": "string"},
        "business_capabilities": {"type": "array", "items": {"type": "string"}},
        "data_inputs": {"type": "array", "items": {"type": "string"}},
        "canonical_entities": {"type": "array", "items": {"type": "string"}},
        "deterministic_components": {"type": "array", "items": {"type": "string"}},
        "ml_components": {"type": "array", "items": {"type": "string"}},
        "llm_components": {"type": "array", "items": {"type": "string"}},
        "integrations": {"type": "array", "items": {"type": "string"}},
        "hitl": {"type": "array", "items": {"type": "string"}},
        "observability": {"type": "array", "items": {"type": "string"}},
        "security_governance": {"type": "array", "items": {"type": "string"}},
        "failure_fallbacks": {"type": "array", "items": {"type": "string"}},
        "commercial_products": {"type": "array", "items": {"type": "string"}},
        "open_source_components": {"type": "array", "items": {"type": "string"}},
        "build_buy_partner_options": {"type": "array", "items": {"type": "string"}},
        "pilot_blueprint": {"type": "object"}
      },
      "additionalProperties": false
    },
    "transferability_assessment": {
      "type": "object",
      "required": ["assessment_id", "finalist_id", "sanctions", "local_integrations", "regulation", "data_readiness", "labor_fit", "format_logistics_fit", "local_alternatives", "verdict", "evidence_ids"],
      "properties": {
        "assessment_id": {"type": "string", "pattern": "^V3-TR-[0-9]{3,}$"},
        "finalist_id": {"type": "string"},
        "sanctions": {"type": "string"},
        "local_integrations": {"type": "string"},
        "regulation": {"type": "string"},
        "data_readiness": {"type": "string"},
        "labor_fit": {"type": "string"},
        "format_logistics_fit": {"type": "string"},
        "local_alternatives": {"type": "array", "items": {"type": "string"}},
        "adaptation_requirements": {"type": "array", "items": {"type": "string"}},
        "verdict": {"enum": ["direct_fit", "fit_with_adaptation", "high_risk", "not_transferable", "unknown"]},
        "evidence_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "sufficiency_assessment": {
      "type": "object",
      "required": ["finalist_id", "gate_a", "gate_b", "gate_c", "gate_d", "gate_e", "gate_f", "gate_g", "gate_h", "saturation", "level", "rationale", "l5_requirements"],
      "properties": {
        "finalist_id": {"type": "string"},
        "gate_a": {"enum": ["pass", "qualified", "fail"]},
        "gate_b": {"enum": ["pass", "qualified", "fail"]},
        "gate_c": {"enum": ["pass", "qualified", "fail"]},
        "gate_d": {"enum": ["pass", "qualified", "fail"]},
        "gate_e": {"enum": ["pass", "qualified", "fail"]},
        "gate_f": {"enum": ["pass", "qualified", "fail"]},
        "gate_g": {"enum": ["pass", "qualified", "fail"]},
        "gate_h": {"enum": ["pass", "qualified", "fail"]},
        "saturation": {"type": "boolean"},
        "level": {"enum": ["L4_PASS", "L4_PASS_WITH_QUALIFICATIONS", "L3_ONLY", "REJECTED", "L5_INTERNAL_VALIDATION_REQUIRED"]},
        "rationale": {"type": "string"},
        "l5_requirements": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "kb_node": {
      "type": "object",
      "required": ["node_id", "node_type", "canonical_name", "status", "confidence", "evidence_ids", "version"],
      "properties": {
        "node_id": {"type": "string"},
        "node_type": {"enum": ["retailer", "stakeholder", "pain", "solution_pattern", "observed_solution", "project", "technology", "product", "repository", "architecture", "kpi", "source", "evidence", "claim", "risk", "regulation"]},
        "canonical_name": {"type": "string"},
        "aliases": {"type": "array", "items": {"type": "string"}},
        "status": {"enum": ["observed", "reported", "inferred", "hypothesis", "assumption", "rejected"]},
        "confidence": {"enum": ["high", "medium", "low", "not_applicable"]},
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "valid_from": {"type": ["string", "null"], "format": "date"},
        "valid_to": {"type": ["string", "null"], "format": "date"},
        "attributes": {"type": "object"},
        "version": {"type": "string"}
      },
      "additionalProperties": false
    },
    "kb_edge": {
      "type": "object",
      "required": ["edge_id", "from_node", "relation", "to_node", "confidence", "evidence_ids", "version"],
      "properties": {
        "edge_id": {"type": "string"},
        "from_node": {"type": "string"},
        "relation": {"type": "string"},
        "to_node": {"type": "string"},
        "confidence": {"enum": ["high", "medium", "low"]},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "valid_from": {"type": ["string", "null"], "format": "date"},
        "valid_to": {"type": ["string", "null"], "format": "date"},
        "version": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
