{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "retailer_universe.schema.json",
  "title": "RetailerUniverse",
  "type": "object",
  "additionalProperties": false,
  "required": ["universe_version", "frozen_at", "ranking_decision", "retailers", "adjacent_group", "sensitivity_notes"],
  "properties": {
    "universe_version": {"type": "string"},
    "frozen_at": {"type": "string", "format": "date-time"},
    "ranking_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher", "ranking_year", "metric", "scope", "source_url", "rationale"],
      "properties": {
        "publisher": {"type": "string"},
        "ranking_year": {"type": "integer"},
        "metric": {"type": "string"},
        "scope": {"type": "string"},
        "source_url": {"type": "string", "format": "uri"},
        "rationale": {"type": "string"},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "retailers": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["retailer_id", "rank", "legal_group", "consumer_brands", "ranking_value_raw", "include_primary_universe", "rationale"],
        "properties": {
          "retailer_id": {"type": "string", "pattern": "^R(0[1-9]|10)$"},
          "rank": {"type": "integer", "minimum": 1, "maximum": 10},
          "legal_group": {"type": "string"},
          "consumer_brands": {"type": "array", "items": {"type": "string"}},
          "ranking_value_raw": {"type": "string"},
          "business_scope": {"type": "string"},
          "include_primary_universe": {"const": true},
          "rationale": {"type": "string"},
          "ownership_notes": {"type": "string"}
        }
      }
    },
    "adjacent_group": {"type": "array", "items": {"type": "object"}},
    "sensitivity_notes": {"type": "array", "items": {"type": "string"}}
  }
}
