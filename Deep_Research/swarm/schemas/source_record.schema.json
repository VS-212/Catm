{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source_record.schema.json",
  "title": "SourceRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id", "agent_id", "url", "source_title", "publisher", "publication_date", "access_date", "source_type", "source_tier", "primary_or_secondary", "independence_group_id", "status"],
  "properties": {
    "source_id": {"type": "string", "pattern": "^[A-Z0-9]+-S[0-9]{4,}$"},
    "agent_id": {"type": "string"},
    "url": {"type": "string", "format": "uri"},
    "canonical_url": {"type": ["string", "null"], "format": "uri"},
    "archive_url": {"type": ["string", "null"], "format": "uri"},
    "source_title": {"type": "string", "minLength": 1},
    "publisher": {"type": "string", "minLength": 1},
    "publication_date": {"type": ["string", "null"], "format": "date"},
    "event_date": {"type": ["string", "null"], "format": "date"},
    "access_date": {"type": "string", "format": "date"},
    "source_type": {"type": "string", "enum": ["annual_report", "strategy", "investor_presentation", "retailer_press_release", "procurement_rfp", "vacancy", "official_video", "interview", "conference_video", "conference_program", "trade_media", "business_media", "research_report", "vendor_case", "regulatory", "other"]},
    "source_tier": {"type": "string", "enum": ["P0", "P1", "S1", "S2", "V", "W", "REJECT"]},
    "primary_or_secondary": {"type": "string", "enum": ["primary", "secondary", "vendor", "weak_signal", "unknown"]},
    "author_or_speaker": {"type": ["string", "null"]},
    "speaker_role_at_event": {"type": ["string", "null"]},
    "retailer_id": {"type": ["string", "null"]},
    "language": {"type": "string", "default": "ru"},
    "access_status": {"type": "string", "enum": ["open", "paywall", "login", "deleted", "private", "unavailable", "snippet_only"]},
    "independence_group_id": {"type": "string", "minLength": 1},
    "full_text_saved": {"type": "boolean"},
    "reliability_notes": {"type": "string"},
    "status": {"type": "string", "enum": ["accepted", "rejected", "lead_only", "pending"]},
    "rejection_reason": {"type": ["string", "null"]}
  }
}
