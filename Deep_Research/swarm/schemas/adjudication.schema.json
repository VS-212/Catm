{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adjudication.schema.json",
  "title": "AdjudicationRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["adjudication_id", "target_type", "target_id", "strongest_support", "strongest_counterevidence", "decision", "final_confidence", "allowed_final_wording", "unresolved_ambiguity", "next_evidence_needed"],
  "properties": {
    "adjudication_id": {"type": "string", "pattern": "^J01-J[0-9]{4,}$"},
    "target_type": {"type": "string", "enum": ["claim", "trend", "project", "method", "dataset"]},
    "target_id": {"type": "string"},
    "strongest_support": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "strongest_counterevidence": {"type": "array", "items": {"type": "string"}},
    "decision": {"type": "string", "enum": ["accepted", "qualified", "rejected", "unresolved", "repair_required"]},
    "final_confidence": {"type": "string", "enum": ["high", "medium", "low", "not_applicable"]},
    "allowed_final_wording": {"type": "string"},
    "unresolved_ambiguity": {"type": "string"},
    "next_evidence_needed": {"type": "array", "items": {"type": "string"}},
    "related_challenge_ids": {"type": "array", "items": {"type": "string"}},
    "related_evidence_ids": {"type": "array", "items": {"type": "string"}}
  }
}
