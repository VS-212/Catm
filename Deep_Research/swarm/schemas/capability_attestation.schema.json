{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability_attestation.schema.json",
  "title": "CapabilityAttestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "orchestrator", "real_subagent_spawn_available", "separate_contexts_available", "parallel_execution_available", "web_access_per_subagent", "file_output_per_subagent", "max_concurrency_observed", "attestation_status", "limitations", "timestamp"],
  "properties": {
    "run_id": {"type": "string"},
    "orchestrator": {"type": "string"},
    "real_subagent_spawn_available": {"type": "boolean"},
    "separate_contexts_available": {"type": "boolean"},
    "parallel_execution_available": {"type": "boolean"},
    "web_access_per_subagent": {"type": "boolean"},
    "file_output_per_subagent": {"type": "boolean"},
    "max_concurrency_observed": {"type": "integer", "minimum": 0},
    "proof_or_run_metadata": {"type": "array", "items": {"type": "string"}},
    "attestation_status": {"type": "string", "enum": ["PASS_REAL_SWARM", "HALT_NO_REAL_SUBAGENTS", "HALT_NO_CONTEXT_ISOLATION", "HALT_NO_WEB", "LIMITED_REQUIRES_USER_APPROVAL"]},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "timestamp": {"type": "string", "format": "date-time"}
  }
}
