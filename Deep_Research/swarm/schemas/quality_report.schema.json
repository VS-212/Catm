{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quality_report.schema.json",
  "title": "RunQualityReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "schema_validation", "referential_integrity", "coverage", "evidence_counts", "video_counts", "claim_counts", "critical_violations", "unresolved_material_issues", "overall_status"],
  "properties": {
    "run_id": {"type": "string"},
    "schema_validation": {"type": "object"},
    "referential_integrity": {"type": "object"},
    "coverage": {"type": "object"},
    "evidence_counts": {
      "type": "object",
      "required": ["raw", "accepted", "qualified", "rejected", "unresolved"],
      "properties": {
        "raw": {"type": "integer", "minimum": 0},
        "accepted": {"type": "integer", "minimum": 0},
        "qualified": {"type": "integer", "minimum": 0},
        "rejected": {"type": "integer", "minimum": 0},
        "unresolved": {"type": "integer", "minimum": 0}
      }
    },
    "video_counts": {"type": "object"},
    "claim_counts": {"type": "object"},
    "critical_violations": {"type": "array", "items": {"type": "string"}},
    "unresolved_material_issues": {"type": "array", "items": {"type": "string"}},
    "overall_status": {"type": "string", "enum": ["PASS", "PASS_WITH_QUALIFICATIONS", "FAIL"]}
  }
}
