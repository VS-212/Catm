{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_record.schema.json",
  "title": "EvidenceRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "agent_id", "retailer_id", "source_id", "publication_date", "year_bucket", "raw_term", "normalized_topic_l1", "normalized_topic_l2", "signal_type", "claim_class", "verbatim_quote", "maturity_stage", "source_quality_score", "directness_score", "specificity_score", "verification_status", "confidence"],
  "properties": {
    "evidence_id": {"type": "string", "pattern": "^[A-Z0-9]+-E[0-9]{4,}$"},
    "agent_id": {"type": "string"},
    "retailer_id": {"type": "string"},
    "source_id": {"type": "string"},
    "event_date": {"type": ["string", "null"], "format": "date"},
    "publication_date": {"type": ["string", "null"], "format": "date"},
    "year_bucket": {"type": "string", "enum": ["2024", "2025", "2026_YTD", "baseline_pre_2024"]},
    "raw_term": {"type": "string"},
    "normalized_topic_l1": {"type": "string"},
    "normalized_topic_l2": {"type": "string"},
    "signal_type": {"type": "string", "enum": ["problem_statement", "strategic_priority", "interest", "pilot", "implementation", "scale", "result", "rfp", "vacancy", "reorganization", "partnership", "conference_topic", "negative_signal", "market_context_only"]},
    "claim_class": {"type": "string", "enum": ["F", "R"]},
    "verbatim_quote": {"type": "string", "minLength": 1},
    "quote_location_or_timestamp": {"type": ["string", "null"]},
    "speaker_name": {"type": ["string", "null"]},
    "speaker_role": {"type": ["string", "null"]},
    "stakeholder_level": {"type": "string", "enum": ["board", "c_level", "c_minus_1", "catman_director", "category_manager", "pm", "it_data", "supply_chain", "operations", "vendor", "media", "unknown"]},
    "problem_or_goal": {"type": ["string", "null"]},
    "concrete_action": {"type": ["string", "null"]},
    "maturity_stage": {"type": "integer", "minimum": 0, "maximum": 5},
    "scale_disclosed": {"type": ["string", "null"]},
    "kpi_disclosed": {"type": ["string", "null"]},
    "kpi_value_raw": {"type": ["string", "null"]},
    "technology_or_vendor": {"type": ["string", "null"]},
    "project_owner_inferred_or_stated": {"type": ["string", "null"]},
    "owner_status": {"type": "string", "enum": ["stated", "inferred", "unknown"]},
    "current_solution": {"type": ["string", "null"]},
    "stated_limitation": {"type": ["string", "null"]},
    "geography_or_format": {"type": ["string", "null"]},
    "source_quality_score": {"type": "integer", "minimum": 0, "maximum": 4},
    "directness_score": {"type": "integer", "minimum": 0, "maximum": 4},
    "specificity_score": {"type": "integer", "minimum": 0, "maximum": 4},
    "verification_status": {"type": "string", "enum": ["raw_unverified", "accepted", "qualified", "rejected", "unresolved"]},
    "confidence": {"type": "string", "enum": ["high", "medium", "low", "rejected"]},
    "analyst_note": {"type": "string"},
    "contradictory_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
