{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim.schema.json",
  "title": "AnalyticalClaim",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim_id", "agent_id", "claim_text_exact", "claim_class", "scope", "supporting_evidence_ids", "contradicting_evidence_ids", "independent_retailer_count", "confidence", "strongest_counterexplanation", "allowed_final_wording", "status"],
  "properties": {
    "claim_id": {"type": "string", "pattern": "^[A-Z0-9]+-K[0-9]{4,}$"},
    "agent_id": {"type": "string"},
    "claim_text_exact": {"type": "string", "minLength": 1},
    "claim_class": {"type": "string", "enum": ["I", "H", "A"]},
    "scope": {"type": "string"},
    "normalized_topic": {"type": ["string", "null"]},
    "supporting_evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "contradicting_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "independent_retailer_count": {"type": "integer", "minimum": 0},
    "independent_source_group_count": {"type": "integer", "minimum": 0},
    "strongest_source_tier": {"type": "string", "enum": ["P0", "P1", "S1", "S2", "V", "W", "unknown"]},
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "strongest_counterexplanation": {"type": "string"},
    "allowed_final_wording": {"type": "string"},
    "status": {"type": "string", "enum": ["proposed", "accepted", "qualified", "rejected", "unresolved"]}
  }
}
