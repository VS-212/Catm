{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fact_check.schema.json",
  "title": "FactCheckVerdict",
  "type": "object",
  "additionalProperties": false,
  "required": ["check_id", "checker_agent_id", "evidence_id", "source_opened", "quote_verified", "date_verified", "speaker_role_verified", "independence_checked", "maturity_checked", "verdict", "reason", "checked_at"],
  "properties": {
    "check_id": {"type": "string", "pattern": "^[A-Z0-9]+-C[0-9]{4,}$"},
    "checker_agent_id": {"type": "string"},
    "evidence_id": {"type": "string"},
    "source_opened": {"type": "boolean"},
    "quote_verified": {"type": "string", "enum": ["yes", "partial", "no", "not_applicable"]},
    "date_verified": {"type": "string", "enum": ["yes", "corrected", "no", "unknown"]},
    "speaker_role_verified": {"type": "string", "enum": ["yes", "corrected", "no", "not_applicable", "unknown"]},
    "number_scope_verified": {"type": "string", "enum": ["yes", "partial", "no", "not_applicable"]},
    "independence_checked": {"type": "boolean"},
    "vendor_laundering_risk": {"type": "string", "enum": ["none", "low", "medium", "high"]},
    "maturity_checked": {"type": "boolean"},
    "verdict": {"type": "string", "enum": ["accepted", "qualified", "rejected", "unresolved"]},
    "reason": {"type": "string", "minLength": 1},
    "correction_patch": {"type": ["object", "null"], "additionalProperties": true},
    "additional_source_urls": {"type": "array", "items": {"type": "string", "format": "uri"}, "uniqueItems": true},
    "checked_at": {"type": "string", "format": "date-time"}
  }
}
