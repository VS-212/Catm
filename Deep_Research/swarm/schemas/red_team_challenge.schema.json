{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "red_team_challenge.schema.json",
  "title": "RedTeamChallenge",
  "type": "object",
  "additionalProperties": false,
  "required": ["challenge_id", "target_type", "target_id", "challenge_type", "challenge_text", "supporting_evidence_ids", "supporting_urls", "severity", "recommended_effect", "confidence"],
  "properties": {
    "challenge_id": {"type": "string", "pattern": "^Z01-Z[0-9]{4,}$"},
    "target_type": {"type": "string", "enum": ["claim", "trend", "project", "method", "dataset"]},
    "target_id": {"type": "string"},
    "challenge_type": {"type": "string", "enum": ["confirmation_bias", "semantic_drift", "media_amplification", "vendor_laundering", "maturity_inflation", "stakeholder_inflation", "temporal_illusion", "alternative_winner", "commodity_risk", "causality", "data_readiness", "organizational_fit", "other"]},
    "challenge_text": {"type": "string", "minLength": 1},
    "supporting_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "supporting_urls": {"type": "array", "items": {"type": "string", "format": "uri"}, "uniqueItems": true},
    "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
    "recommended_effect": {"type": "string", "enum": ["reject", "qualify", "lower_confidence", "lower_score", "repair_research", "no_change"]},
    "score_delta_recommendation": {"type": ["number", "null"], "maximum": 0},
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]}
  }
}
