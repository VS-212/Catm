{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run_manifest.schema.json",
  "title": "SwarmRunManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "run_id", "orchestrator", "started_at", "completed_at", "specialist_runs", "repair_runs", "wave_statuses"],
  "properties": {
    "project_id": {"const": "CATMAN-RU-DR-2024-2026"},
    "run_id": {"type": "string"},
    "orchestrator": {"type": "string"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "specialist_runs": {
      "type": "array",
      "minItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agent_id", "external_run_id", "wave", "started_at", "completed_at", "input_files", "output_files", "status", "retry_count"],
        "properties": {
          "agent_id": {"type": "string"},
          "external_run_id": {"type": "string", "minLength": 1},
          "wave": {"type": "string"},
          "model_or_runtime": {"type": ["string", "null"]},
          "started_at": {"type": "string", "format": "date-time"},
          "completed_at": {"type": ["string", "null"], "format": "date-time"},
          "input_files": {"type": "array", "items": {"type": "string"}},
          "output_files": {"type": "array", "items": {"type": "string"}},
          "status": {"type": "string", "enum": ["completed", "failed", "partial", "repaired"]},
          "retry_count": {"type": "integer", "minimum": 0, "maximum": 1},
          "error_summary": {"type": ["string", "null"]}
        }
      }
    },
    "repair_runs": {"type": "array", "maxItems": 4, "items": {"type": "object"}},
    "wave_statuses": {"type": "array", "items": {"type": "object"}}
  }
}
