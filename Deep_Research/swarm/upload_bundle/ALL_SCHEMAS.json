        "full_text_saved": {
          "type": "boolean"
        },
        "reliability_notes": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "rejected",
            "lead_only",
            "pending"
          ]
        },
        "rejection_reason": {
          "type": [
            "string",
            "null"
          ]
        }
