            "S1",
            "S2",
            "V",
            "W",
            "REJECT"
          ]
        },
        "primary_or_secondary": {
          "type": "string",
          "enum": [
            "primary",
            "secondary",
            "vendor",
            "weak_signal",
            "unknown"
          ]
