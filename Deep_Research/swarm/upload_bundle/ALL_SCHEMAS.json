{
  "bundle_version": "1.0",
  "schemas": {
    "adjudication.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "adjudication.schema.json",
      "title": "AdjudicationRecord",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adjudication_id",
        "target_type",
        "target_id",
        "strongest_support",
        "strongest_counterevidence",
        "decision",
        "final_confidence",
        "allowed_final_wording",
        "unresolved_ambiguity",
        "next_evidence_needed"
      ],
      "properties": {
        "adjudication_id": {
          "type": "string",
          "pattern": "^J01-J[0-9]{4,}$"
        },
        "target_type": {
          "type": "string",
          "enum": [
            "claim",
            "trend",
            "project",
            "method",
            "dataset"
          ]
        },
        "target_id": {
          "type": "string"
        },
        "strongest_support": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "strongest_counterevidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decision": {
          "type": "string",
          "enum": [
            "accepted",
            "qualified",
            "rejected",
            "unresolved",
            "repair_required"
          ]
        },
        "final_confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "not_applicable"
          ]
        },
        "allowed_final_wording": {
          "type": "string"
        },
        "unresolved_ambiguity": {
          "type": "string"
        },
        "next_evidence_needed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related_challenge_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "capability_attestation.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "capability_attestation.schema.json",
      "title": "CapabilityAttestation",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "orchestrator",
        "real_subagent_spawn_available",
        "separate_contexts_available",
        "parallel_execution_available",
        "web_access_per_subagent",
        "file_output_per_subagent",
        "max_concurrency_observed",
        "attestation_status",
        "limitations",
        "timestamp"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "orchestrator": {
          "type": "string"
        },
        "real_subagent_spawn_available": {
          "type": "boolean"
        },
        "separate_contexts_available": {
          "type": "boolean"
        },
        "parallel_execution_available": {
          "type": "boolean"
        },
        "web_access_per_subagent": {
          "type": "boolean"
        },
        "file_output_per_subagent": {
          "type": "boolean"
        },
        "max_concurrency_observed": {
          "type": "integer",
          "minimum": 0
        },
        "proof_or_run_metadata": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attestation_status": {
          "type": "string",
          "enum": [
            "PASS_REAL_SWARM",
            "HALT_NO_REAL_SUBAGENTS",
            "HALT_NO_CONTEXT_ISOLATION",
            "HALT_NO_WEB",
            "LIMITED_REQUIRES_USER_APPROVAL"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "claim.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "claim.schema.json",
      "title": "AnalyticalClaim",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "agent_id",
        "claim_text_exact",
        "claim_class",
        "scope",
        "supporting_evidence_ids",
        "contradicting_evidence_ids",
        "independent_retailer_count",
        "confidence",
        "strongest_counterexplanation",
        "allowed_final_wording",
        "status"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^[A-Z0-9]+-K[0-9]{4,}$"
        },
        "agent_id": {
          "type": "string"
        },
        "claim_text_exact": {
          "type": "string",
          "minLength": 1
        },
        "claim_class": {
          "type": "string",
          "enum": [
            "I",
            "H",
            "A"
          ]
        },
        "scope": {
          "type": "string"
        },
        "normalized_topic": {
          "type": [
            "string",
            "null"
          ]
        },
        "supporting_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "contradicting_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "independent_retailer_count": {
          "type": "integer",
          "minimum": 0
        },
        "independent_source_group_count": {
          "type": "integer",
          "minimum": 0
        },
        "strongest_source_tier": {
          "type": "string",
          "enum": [
            "P0",
            "P1",
            "S1",
            "S2",
            "V",
            "W",
            "unknown"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "strongest_counterexplanation": {
          "type": "string"
        },
        "allowed_final_wording": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "accepted",
            "qualified",
            "rejected",
            "unresolved"
          ]
        }
      }
    },
    "evidence_record.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "evidence_record.schema.json",
      "title": "EvidenceRecord",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "agent_id",
        "retailer_id",
        "source_id",
        "publication_date",
        "year_bucket",
        "raw_term",
        "normalized_topic_l1",
        "normalized_topic_l2",
        "signal_type",
        "claim_class",
        "verbatim_quote",
        "maturity_stage",
        "source_quality_score",
        "directness_score",
        "specificity_score",
        "verification_status",
        "confidence"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^[A-Z0-9]+-E[0-9]{4,}$"
        },
        "agent_id": {
          "type": "string"
        },
        "retailer_id": {
          "type": "string"
        },
        "source_id": {
          "type": "string"
        },
        "event_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "publication_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "year_bucket": {
          "type": "string",
          "enum": [
            "2024",
            "2025",
            "2026_YTD",
            "baseline_pre_2024"
          ]
        },
        "raw_term": {
          "type": "string"
        },
        "normalized_topic_l1": {
          "type": "string"
        },
        "normalized_topic_l2": {
          "type": "string"
        },
        "signal_type": {
          "type": "string",
          "enum": [
            "problem_statement",
            "strategic_priority",
            "interest",
            "pilot",
            "implementation",
            "scale",
            "result",
            "rfp",
            "vacancy",
            "reorganization",
            "partnership",
            "conference_topic",
            "negative_signal",
            "market_context_only"
          ]
        },
        "claim_class": {
          "type": "string",
          "enum": [
            "F",
            "R"
          ]
        },
        "verbatim_quote": {
          "type": "string",
          "minLength": 1
        },
        "quote_location_or_timestamp": {
          "type": [
            "string",
            "null"
          ]
        },
        "speaker_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "speaker_role": {
          "type": [
            "string",
            "null"
          ]
        },
        "stakeholder_level": {
          "type": "string",
          "enum": [
            "board",
            "c_level",
            "c_minus_1",
            "catman_director",
            "category_manager",
            "pm",
            "it_data",
            "supply_chain",
            "operations",
            "vendor",
            "media",
            "unknown"
          ]
        },
        "problem_or_goal": {
          "type": [
            "string",
            "null"
          ]
        },
        "concrete_action": {
          "type": [
            "string",
            "null"
          ]
        },
        "maturity_stage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "scale_disclosed": {
          "type": [
            "string",
            "null"
          ]
        },
        "kpi_disclosed": {
          "type": [
            "string",
            "null"
          ]
        },
        "kpi_value_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "technology_or_vendor": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_owner_inferred_or_stated": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner_status": {
          "type": "string",
          "enum": [
            "stated",
            "inferred",
            "unknown"
          ]
        },
        "current_solution": {
          "type": [
            "string",
            "null"
          ]
        },
        "stated_limitation": {
          "type": [
            "string",
            "null"
          ]
        },
        "geography_or_format": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_quality_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "directness_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "specificity_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "raw_unverified",
            "accepted",
            "qualified",
            "rejected",
            "unresolved"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "rejected"
          ]
        },
        "analyst_note": {
          "type": "string"
        },
        "contradictory_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "fact_check.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "fact_check.schema.json",
      "title": "FactCheckVerdict",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "checker_agent_id",
        "evidence_id",
        "source_opened",
        "quote_verified",
        "date_verified",
        "speaker_role_verified",
        "independence_checked",
        "maturity_checked",
        "verdict",
        "reason",
        "checked_at"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "pattern": "^[A-Z0-9]+-C[0-9]{4,}$"
        },
        "checker_agent_id": {
          "type": "string"
        },
        "evidence_id": {
          "type": "string"
        },
        "source_opened": {
          "type": "boolean"
        },
        "quote_verified": {
          "type": "string",
          "enum": [
            "yes",
            "partial",
            "no",
            "not_applicable"
          ]
        },
        "date_verified": {
          "type": "string",
          "enum": [
            "yes",
            "corrected",
            "no",
            "unknown"
          ]
        },
        "speaker_role_verified": {
          "type": "string",
          "enum": [
            "yes",
            "corrected",
            "no",
            "not_applicable",
            "unknown"
          ]
        },
        "number_scope_verified": {
          "type": "string",
          "enum": [
            "yes",
            "partial",
            "no",
            "not_applicable"
          ]
        },
        "independence_checked": {
          "type": "boolean"
        },
        "vendor_laundering_risk": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high"
          ]
        },
        "maturity_checked": {
          "type": "boolean"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "accepted",
            "qualified",
            "rejected",
            "unresolved"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "correction_patch": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "additional_source_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "uniqueItems": true
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "project_hypothesis.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "project_hypothesis.schema.json",
      "title": "ProjectHypothesis",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "project_name",
        "pain_statement",
        "supporting_claim_ids",
        "retailers_with_demand_signal",
        "primary_owner",
        "project_hypothesis",
        "scope",
        "non_scope",
        "pilot_design",
        "primary_kpi",
        "expected_effect_status",
        "scores",
        "penalties",
        "total_after_penalties",
        "kill_criteria",
        "main_counterargument",
        "confidence"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^PRJ-[0-9]{2,}$"
        },
        "project_name": {
          "type": "string",
          "minLength": 1
        },
        "pain_statement": {
          "type": "string"
        },
        "supporting_claim_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "retailers_with_demand_signal": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "primary_owner": {
          "type": "string"
        },
        "beneficiaries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "current_workaround": {
          "type": [
            "string",
            "null"
          ]
        },
        "why_current_solution_insufficient": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_hypothesis": {
          "type": "string"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "non_scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "required_data": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "operating_model_change": {
          "type": "string"
        },
        "pilot_design": {
          "type": "string"
        },
        "baseline": {
          "type": [
            "string",
            "null"
          ]
        },
        "primary_kpi": {
          "type": "string"
        },
        "secondary_kpis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "guardrails": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_effect_status": {
          "type": "string",
          "enum": [
            "sourced",
            "assumption_A",
            "to_be_measured",
            "mixed"
          ]
        },
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "demand_evidence",
            "business_value",
            "executive_urgency",
            "feasibility",
            "time_to_effect",
            "novelty",
            "pm_leverage",
            "scalability"
          ],
          "properties": {
            "demand_evidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 25
            },
            "business_value": {
              "type": "number",
              "minimum": 0,
              "maximum": 20
            },
            "executive_urgency": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "feasibility": {
              "type": "number",
              "minimum": 0,
              "maximum": 15
            },
            "time_to_effect": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "novelty": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "pm_leverage": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "scalability": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            }
          }
        },
        "penalties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence_debt",
            "vendor_only",
            "terminology",
            "data_change_risk",
            "commodity"
          ],
          "properties": {
            "evidence_debt": {
              "type": "number",
              "minimum": -15,
              "maximum": 0
            },
            "vendor_only": {
              "type": "number",
              "minimum": -10,
              "maximum": 0
            },
            "terminology": {
              "type": "number",
              "minimum": -5,
              "maximum": 0
            },
            "data_change_risk": {
              "type": "number",
              "minimum": -10,
              "maximum": 0
            },
            "commodity": {
              "type": "number",
              "minimum": -10,
              "maximum": 0
            }
          }
        },
        "total_after_penalties": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "kill_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "main_counterargument": {
          "type": "string"
        },
        "switch_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "quality_report.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "quality_report.schema.json",
      "title": "RunQualityReport",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "schema_validation",
        "referential_integrity",
        "coverage",
        "evidence_counts",
        "video_counts",
        "claim_counts",
        "critical_violations",
        "unresolved_material_issues",
        "overall_status"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "schema_validation": {
          "type": "object"
        },
        "referential_integrity": {
          "type": "object"
        },
        "coverage": {
          "type": "object"
        },
        "evidence_counts": {
          "type": "object",
          "required": [
            "raw",
            "accepted",
            "qualified",
            "rejected",
            "unresolved"
          ],
          "properties": {
            "raw": {
              "type": "integer",
              "minimum": 0
            },
            "accepted": {
              "type": "integer",
              "minimum": 0
            },
            "qualified": {
              "type": "integer",
              "minimum": 0
            },
            "rejected": {
              "type": "integer",
              "minimum": 0
            },
            "unresolved": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "video_counts": {
          "type": "object"
        },
        "claim_counts": {
          "type": "object"
        },
        "critical_violations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unresolved_material_issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "overall_status": {
          "type": "string",
          "enum": [
            "PASS",
            "PASS_WITH_QUALIFICATIONS",
            "FAIL"
          ]
        }
      }
    },
    "red_team_challenge.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "red_team_challenge.schema.json",
      "title": "RedTeamChallenge",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challenge_id",
        "target_type",
        "target_id",
        "challenge_type",
        "challenge_text",
        "supporting_evidence_ids",
        "supporting_urls",
        "severity",
        "recommended_effect",
        "confidence"
      ],
      "properties": {
        "challenge_id": {
          "type": "string",
          "pattern": "^Z01-Z[0-9]{4,}$"
        },
        "target_type": {
          "type": "string",
          "enum": [
            "claim",
            "trend",
            "project",
            "method",
            "dataset"
          ]
        },
        "target_id": {
          "type": "string"
        },
        "challenge_type": {
          "type": "string",
          "enum": [
            "confirmation_bias",
            "semantic_drift",
            "media_amplification",
            "vendor_laundering",
            "maturity_inflation",
            "stakeholder_inflation",
            "temporal_illusion",
            "alternative_winner",
            "commodity_risk",
            "causality",
            "data_readiness",
            "organizational_fit",
            "other"
          ]
        },
        "challenge_text": {
          "type": "string",
          "minLength": 1
        },
        "supporting_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "supporting_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "uniqueItems": true
        },
        "severity": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "recommended_effect": {
          "type": "string",
          "enum": [
            "reject",
            "qualify",
            "lower_confidence",
            "lower_score",
            "repair_research",
            "no_change"
          ]
        },
        "score_delta_recommendation": {
          "type": [
            "number",
            "null"
          ],
          "maximum": 0
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "retailer_universe.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "retailer_universe.schema.json",
      "title": "RetailerUniverse",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "universe_version",
        "frozen_at",
        "ranking_decision",
        "retailers",
        "adjacent_group",
        "sensitivity_notes"
      ],
      "properties": {
        "universe_version": {
          "type": "string"
        },
        "frozen_at": {
          "type": "string",
          "format": "date-time"
        },
        "ranking_decision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "publisher",
            "ranking_year",
            "metric",
            "scope",
            "source_url",
            "rationale"
          ],
          "properties": {
            "publisher": {
              "type": "string"
            },
            "ranking_year": {
              "type": "integer"
            },
            "metric": {
              "type": "string"
            },
            "scope": {
              "type": "string"
            },
            "source_url": {
              "type": "string",
              "format": "uri"
            },
            "rationale": {
              "type": "string"
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "retailers": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "retailer_id",
              "rank",
              "legal_group",
              "consumer_brands",
              "ranking_value_raw",
              "include_primary_universe",
              "rationale"
            ],
            "properties": {
              "retailer_id": {
                "type": "string",
                "pattern": "^R(0[1-9]|10)$"
              },
              "rank": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "legal_group": {
                "type": "string"
              },
              "consumer_brands": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "ranking_value_raw": {
                "type": "string"
              },
              "business_scope": {
                "type": "string"
              },
              "include_primary_universe": {
                "const": true
              },
              "rationale": {
                "type": "string"
              },
              "ownership_notes": {
                "type": "string"
              }
            }
          }
        },
        "adjacent_group": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "sensitivity_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "run_manifest.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "run_manifest.schema.json",
      "title": "SwarmRunManifest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "run_id",
        "orchestrator",
        "started_at",
        "completed_at",
        "specialist_runs",
        "repair_runs",
        "wave_statuses"
      ],
      "properties": {
        "project_id": {
          "const": "CATMAN-RU-DR-2024-2026"
        },
        "run_id": {
          "type": "string"
        },
        "orchestrator": {
          "type": "string"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "specialist_runs": {
          "type": "array",
          "minItems": 25,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "agent_id",
              "external_run_id",
              "wave",
              "started_at",
              "completed_at",
              "input_files",
              "output_files",
              "status",
              "retry_count"
            ],
            "properties": {
              "agent_id": {
                "type": "string"
              },
              "external_run_id": {
                "type": "string",
                "minLength": 1
              },
              "wave": {
                "type": "string"
              },
              "model_or_runtime": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "started_at": {
                "type": "string",
                "format": "date-time"
              },
              "completed_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "input_files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "output_files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "status": {
                "type": "string",
                "enum": [
                  "completed",
                  "failed",
                  "partial",
                  "repaired"
                ]
              },
              "retry_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "error_summary": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "repair_runs": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object"
          }
        },
        "wave_statuses": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "source_record.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "source_record.schema.json",
      "title": "SourceRecord",
