            "null"
          ],
          "format": "uri"
        },
        "source_title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "publication_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "event_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "access_date": {
          "type": "string",
          "format": "date"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "annual_report",
            "strategy",
            "investor_presentation",
            "retailer_press_release",
            "procurement_rfp",
            "vacancy",
            "official_video",
            "interview",
            "conference_video",
            "conference_program",
            "trade_media",
            "business_media",
            "research_report",
            "vendor_case",
            "regulatory",
            "other"
          ]
